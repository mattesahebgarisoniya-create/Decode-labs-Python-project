tasks = []

while True:
    print("\nTo-Do List")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        task = input("Enter your task: ")
        tasks.append(task)
        print("Task added successfully!")

    elif choice == "2":
        if len(tasks) == 0:
            print("No tasks added yet.")
        else:
            print("\nMy Tasks:")
            for task in tasks:
                print("-", task)

    elif choice == "3":
        print("Thank you!")
        break

    else:
        print("Please enter a valid choice.")